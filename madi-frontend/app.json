{
  "expo": {
    "name": "madi",
    "slug": "madi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/madi-icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/madi-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rollinpebbles.madi"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6334368151294945~5051636415"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/madi-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3deda588-8c73-4dfe-9e73-a0594e847653"
      }
    },
    "owner": "rollinpebbles"
  }
}
